rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function isAdmin() { return role() == 'admin'; }
    function isWaiter() { return role() == 'waiter'; }
    function isKitchen() { return role() == 'kitchen'; }
    function canOperateOrders() { return isAdmin() || isWaiter(); }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /tables/{tableId} {
      allow read: if signedIn();
      allow create, update: if canOperateOrders();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn();
      allow create: if canOperateOrders()
        && request.resource.data.status == 'draft'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if canOperateOrders()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status != 'closed';
      allow delete: if false;
    }

    match /kitchenTickets/{ticketId} {
      allow read: if signedIn();
      allow create: if canOperateOrders();
      allow update: if isAdmin() || isKitchen();
      allow delete: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dailyReports/{reportId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
